{
  "name": "cocina-central",
  "version": "0.1.0",
  "private": true,
  "description": "Amoenus - Cocina Central: gestor de pedidos de tiendas al obrador",
  "type": "module",
  "scripts": {
    "all:dev": "run-p -l api:dev web:dev",
    "all:build": "pnpm -r --if-present build",
    "all:type-check": "pnpm -r --if-present type-check",
    "all:lint": "pnpm -r --if-present lint",
    "all:test": "vitest run",
    "all:format": "prettier --write .",
    "all:format-check": "prettier --check .",
    "api:dev": "pnpm --filter @cocina-central/api dev",
    "web:dev": "pnpm --filter @cocina-central/web dev",
    "db:up": "docker compose up -d mongo",
    "db:down": "docker compose down",
    "db:seed": "pnpm --filter @cocina-central/api db:seed"
  },
  "devDependencies": {
    "npm-run-all2": "^9.0.3",
    "prettier": "3.9.6",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24.11.0",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.28.2+sha512.755ce2fe3c05bfd7bb412b42aff3c5c55cd38c529c6eca810475497ae36746c571e4b6e1814e6e7e4b97d7ee864b8a0e44673c3b297a50e0ac28771c5ce15d27"
}
