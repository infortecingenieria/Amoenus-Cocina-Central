# Copia este fichero a .env para desarrollo local.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Mongo local levantado con `npm run db:up` (docker-compose.yml en la raíz).
MONGODB_URI=mongodb://127.0.0.1:27017/cocina_central

# Orígenes permitidos por CORS, separados por comas.
CORS_ORIGINS=http://localhost:5173

# Documentación OpenAPI en /docs (desactivar en producción si no se quiere exponer).
API_DOCS_ENABLED=true

# Clave para firmar los tokens de sesión (mínimo 32 caracteres). Cámbiala: en producción, un valor
# aleatorio largo, p. ej. `node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"`.
JWT_SECRET=cambia-esta-clave-de-desarrollo-por-una-aleatoria
# Duración de la sesión.
JWT_EXPIRES_IN=12h
